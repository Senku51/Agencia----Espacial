<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="http://java.sun.com/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://java.sun.com/xml/ns/persistence http://java.sun.com/xml/ns/persistence/persistence_2_0.xsd"
             version="2.0">

    <persistence-unit name="AgenciaEspacialPU" transaction-type="RESOURCE_LOCAL">

        <provider>com.objectdb.jpa.Provider</provider>

        <class>Entidades.Astronauta</class>
        <class>Entidades.EstacionSeguimiento</class>
        <class>Entidades.Mision</class>
        <class>Entidades.MisionAstronauta</class>
        <class>Entidades.MisionAstronautaId</class>
        <class>Entidades.ModeloVehiculo</class>
        <class>Entidades.Satelite</class>
        <class>Entidades.SateliteEstacion</class>
        <class>Entidades.SateliteEstacionId</class>
        <class>Entidades.Telemetria</class>
        <class>Entidades.Ubicacion</class>
        <class>Entidades.VehiculoLanzamiento</class>

        <properties>
            <!-- Mantenemos tus propiedades de Jakarta porque tu jar de objectdb-jk las entiende perfectamente -->
            <property name="jakarta.persistence.jdbc.url" value="objectdb:agencia_espacial.odb"/>
            <property name="jakarta.persistence.jdbc.user" value="admin"/>
            <property name="jakarta.persistence.jdbc.password" value="admin"/>
        </properties>

    </persistence-unit>

</persistence>